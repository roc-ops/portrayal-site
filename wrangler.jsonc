// portrayal.dev on Cloudflare: static files only, no Worker script.
//
// assets.directory is WHAT GOES LIVE. Until launch it is coming-soon/, the
// self-contained teaser; the repo root must never be published as-is, since
// it carries the vendored Portrayal snapshot, prototypes and check scripts.
// Going live is a public-only folder and a change to this one line.
{
  "name": "portrayal",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./coming-soon",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "portrayal.dev", "custom_domain": true },
    { "pattern": "www.portrayal.dev", "custom_domain": true }
  ]
}
