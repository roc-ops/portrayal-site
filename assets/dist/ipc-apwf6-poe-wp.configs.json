 "provenance": {
  "bottom-layout": {
   "confidence": "estimated",
   "note": "datasheet page 4 and the stock photograph: four RJ45 jacks side by side, legends LAN 1 (with a 'PoE Out' tag beneath it), LAN 2, LAN 3 and LAN 4. The pitch and the margins are read by eye from the photograph and span the end; the jacks are the library's own 15.8 x 13.2."
  },
  "chassis": {
   "confidence": "datasheet",
   "note": "datasheet page 3, Dimensions: 6.69 x 3.39 x 1.69 in (170 x 86 x 43 mm), weight 0.66 lb (0.3 kg). Modelled upright as a plate, 86 mm wide, 170 mm high and 43 mm deep. The figure on page 4 draws the box lying on its back with the four jacks on the right-hand end; which end is the top once it is on a wall is not stated, and the jacks are drawn on the bottom end."
  },
  "chassis-colour": {
   "confidence": "photo-measured",
   "note": "the median of the lit long face and the lit end of the stock photograph, #fdfdfd and #fbfbfb, taken as #fcfcfc; the shaded side reads #e6e6e6, which is the lighting and not the plastic."
  },
  "chassis-shape": {
   "confidence": "estimated",
   "note": "the data sheet gives the three overall dimensions and no edge radius. The stock photograph shows every edge of the box softly rounded, to about 2.5 mm by eye against the 43 mm thickness. The library's bevel cuts an edge at 45 degrees, so each of the twelve edges is drawn as a 2.5 mm chamfer where the photograph shows a round of about that size."
  },
  "front-layout": {
   "confidence": "estimated",
   "note": "the data sheet prints the name ReadyLinks on the plate: in the header of page 1, on the plate's face in the page 1 picture and in small type on it in the page 4 figure. The wordmark is drawn as that name, as text near the top of the face; it is not the maker's logo. The stock photograph prints another maker's name there, on the face near one end, which is not reproduced; the data sheet is the authority for the device's name."
  },
