 "gaps": [
  {
   "because": "sources-disagree",
   "blocks": [],
   "kind": "declared",
   "note": "The MX5/MX10/MX40/MX80 hardware guide says two things about the one management jack. Its Routing Engine description gives one 1-Gbps Ethernet port for the management network; its ETHERNET port pinout section calls the same jack an autosensing 10/100-Mbps RJ-45 receptacle. Neither is carried. The EXT CLK A and B jacks are the two BITS clock inputs the same description lists, so they are `rj48`.",
   "scope": [
    "ethernet"
   ],
   "wanted": "a third source - a datasheet, or a photograph of the jack lamps with a legend - that settles the ETHERNET port at 100M or 1G.",
   "what": "ethernet-port-speed"
  },
  {
   "because": "needs-photo",
   "blocks": [],
   "kind": "declared",
   "scope": [],
   "wanted": "the fixed MX80 faceplate (Figure 8, built-in 48x1GbE) - a different front panel that would be a second device or configuration; only the modular chassis is modelled.",
   "what": "mx80-fixed-variant"
  },
  {
   "because": "needs-photo",
   "blocks": [],
   "kind": "declared",
   "scope": [
    "psus"
   ],
   "wanted": "the DC supply face (guide Figure 16 is isometric line art).",
   "what": "dc-power-variant"
  },
  {
   "because": "vendor-silent",
   "blocks": [],
   "kind": "declared",
   "scope": [],
   "wanted": "the weight and power tables - outside this extraction's text layer; L27/L29 warnings stand on the modules.",
   "what": "chassis-weight-and-power"
  },
  {
   "because": "needs-photo",
   "blocks": [],
   "kind": "declared",
   "scope": [
    "timing"
   ],
   "wanted": "confirmation whether the rear CLK/SYNC jacks are SMB or BNC - drawn SMB, photo resolution insufficient.",
   "what": "rear-clock-jack-type"
  },
  {
   "because": "L29",
   "blocks": [],
   "count": 1,
   "kind": "derived",
   "wanted": "a `power-draw-max-w` on each module this chassis accepts, from the vendor's own per-card table - Cisco publishes one per ambient, most vendors publish none, and until they land a module total is a floor",
   "what": "module-power"
  },
  {
   "because": "L40",
   "blocks": [],
   "count": 1,
   "kind": "derived",
   "wanted": "which optics actually run in each pluggable cage - as prose in `attrs.optics-<media>` for now, which at least reaches the group, and structurally once enough vendors are in to say what the vocabulary has to hold",
   "what": "port-optics-undeclared"
  },
  {
   "because": "CAP",
   "blocks": [
    "specified"
   ],
   "kind": "derived",
   "wanted": "an `attrs.performance` section; `cpu`, `memory` in a missing `attrs.platform` section; one of `power-max-w`, `power-max-ac-w`, `power-max-dc-w` in a missing `attrs.power` section; one of `operating-temp`, `operating-temp-f2b`, `operating-temp-b2f` in a missing `attrs.environmental` section (profile `networking` - see spec/schemas/profiles.yaml) - unlocks the About panel, and comparison against other devices",
   "what": "specified"
  },
  {
   "because": "CAP",
   "blocks": [
    "wired"
   ],
   "kind": "derived",
   "wanted": "`physical-context` on 6 bays (front 5, rear 1) - unlocks ENTITY-MIB / Redfish correlation and monitoring overlays",
   "what": "wired"
  }
 ],
