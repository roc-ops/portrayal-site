 "profile": "networking",
 "provenance": {
  "cellular": {
   "confidence": "datasheet",
   "note": "Data sheet: the -C models add a 5G cellular modem (Sierra Wireless EM9291, 5G NR Sub-6 and LTE CAT20); the cellular models are 189 mm deep and 1.55 kg, and ship with four cellular antennas (569052) and two 4FF SIM card trays (429020). Quick Start Guide: antenna ports and two SIM card slots on the rear; attach the antennas, put the cards in the trays and push the trays in until they click. The rear photograph labels the jacks WWAN1 to WWAN4 and the slots 1 and 2. The rear antenna jacks are SMA by the registry's reading of the photograph (gold hex nut, centre pin); no document names the connector, which is recorded in the gaps."
  },
  "chassis": {
   "confidence": "datasheet",
   "note": "Data sheet, Dimensions and Weight: cellular models 8.66 x 7 x 1.75 in, 220 x 189 x 44 mm, 1.55 kg. Form factor \"Compact - SFF 1RU half-rack width\". The rack kit 590054 ships in the box but no source dimensions it, so the body is drawn alone."
  },
  "front-layout": {
   "confidence": "estimated",
   "note": "Method: the CM8008-C front photograph (2560 x 1440, straight on, no scale marker) is measured against the data sheet envelope. The body outline is 907 px wide and 182 px high at the displayed 2000 px width, 4.12 px/mm across from 220 mm and 4.14 px/mm down from 44 mm, so the face is orthographic to about 1 percent and positions are read at 4.13 px/mm. Every position on the front is read off that photograph and is good to about 0.7 mm: the two SFP cages, the two RJ45 jacks, the 2 x 4 serial block (pitch 14.1 across, rows placed 14.0 apart), the two USB-A ports, the USB-C console, the erase pinhole, the six lamps and the printing. The CM8004 photograph, at 5.7 px/mm, gives the same x for the shared features within 0.3 mm."
  },
  "lamps": {
   "confidence": "datasheet",
   "note": "Quick Start Guide, LED Panel: six LEDs, Power, Heartbeat, Network, IOIO, Cloud / Internet and Cellular Interface, each with its states. The photograph prints the power, heartbeat and network symbols over the top row and IOIO, an antenna and a cloud under the second row. The Cellular lamp is printed on every model, the standard ones included."
  },
  "livery": {
   "confidence": "estimated",
   "note": "The red and charcoal faces, the two diagonal stripes, the white label tabs and the wordmark are read off the photographs at the same scale and are painted livery, not parts. The logo mark is a simplified outline."
  },
  "network": {
   "confidence": "datasheet",
   "note": "Data sheet: \"2 x combo ports - RJ45 100BASE-TX/1000 BASE-T or SFP\"; the model table lists \"2x 1GbE SFP, 2x 1GbE\". The photograph prints NET1(S), NET2(S) over two stacked SFP cages and NET1(C), NET2(C) over two stacked RJ45 jacks, each jack with a green lamp and an amber lamp. The (S) and (C) halves of one number are one combo port; both halves are placed and share the number, the way the library draws other combo ports. The Quick Start Guide's NET1/NET2 lamp table: amber is link at any speed or activity, green is link at 1G."
  },
  "power": {
   "confidence": "datasheet",
   "note": "Data sheet: dual power inputs, the second available as redundancy; one universal 110-240 V AC to 12 V DC external adapter in the box (450048, 65 W, IEC C14 inlet), a 60 W 18-72 V DC kit (450051) as an accessory; consumption \"less than 30 W\" for cellular models. The rear prints 12VDC under each jack. Quick Start Guide: connect a second power cable for redundancy; the power lamp is green for redundancy and amber for none."
  },
  "rear-layout": {
   "confidence": "estimated",
   "note": "Method as the front: the CM8008-C rear photograph is 838 px wide for 220 mm (3.81 px/mm) and 167 px high for 44 mm (3.80 px/mm), so the face is orthographic to about 1 percent. The two 12VDC jacks (centres 158.6 and 208.7 mm), the two cable retention openings (120.0 and 172.2 mm), the four SMA jacks (centres 29.4, 81.6, 133.9 and 186.1 mm, an even 52.2 mm pitch) and the two SIM slots (centres 24.3 and 47.2 mm) are read off it, good to about 0.7 mm. The CM8004 rear photograph, at 5.0 px/mm, gives the jacks and openings within 0.3 mm."
  },
  "serial": {
   "confidence": "datasheet",
   "note": "Data sheet: CM8008-C has 8 RJ45 RS232 \"Cisco straight X2\" pinout serial ports, 50 to 115,200 bps. The pinout drawing prints pin 1 CTS, 2 DSR/DCD, 3 RxD, 4 GND, 5 not connected, 6 TxD, 7 DTR, 8 RTS. The photograph numbers the ports 1, 3, 5 and 7 over 2, 4, 6 and 8, with SERIAL printed between the lower numerals."
  },
  "serial-role": {
   "confidence": "datasheet",
   "note": "The serial ports are console server ports. Quick Start Guide, p.10, \"Configure Serial Ports\": \"The default configuration for serial ports is: Mode: Console Server\". The data sheet, p.1, calls them \"Managed Serial Ports\". The USB-C jack is the local console (data sheet, p.1, \"Local Console Port\")."
  },
  "sides": {
   "confidence": "datasheet",
   "note": "No source shows the top, bottom or either side of the unit. Passive cooling is stated (data sheet) and the front and rear photographs show a row of vent openings along their top edge, drawn on those faces."
  },
  "sources": {
   "confidence": "datasheet",
   "note": "Opengear CM8000 Console Manager datasheet (September 22, 2026): model table, interfaces, power, cooling, dimensions and weight, package checklist and accessories. CM8000 Quick Start Guide v1 (September 2026): \"In the Box\" front and rear callouts, hardware installation steps, the LED panel table. The CM8008-C front and rear photographs and the \"X2 Cisco Straight\" pinout drawing published with them."
  },
  "usb": {
   "confidence": "datasheet",
   "note": "Data sheet: two USB 3.0 ports (mass storage, device console management) and one USB-C console port, default 9600 8N1. The photograph labels the two USB-A jacks A and B and prints the SuperSpeed mark under them."
  }
 },
