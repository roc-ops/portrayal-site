 "profile": "networking",
 "provenance": {
  "bottom-layout": {
   "confidence": "drawing",
   "note": "drawing - the sixteen screw heads are the GL-12xB-240D's reading; the base plate (GL24X-1U-002B) is the same sheet. The axis convention is that device's."
  },
  "chassis": {
   "confidence": "drawing",
   "note": "drawing - the GL-12xC model's body is 440.0 wide (side walls GL24X-1U-003B, 15.0 each), 45.0 tall and 300.1 deep (front panel face to rear panel GL24X-1U-004B), the GL-12xB's boxes to 0.1 mm. The data sheet reads \"12\"(L) x 19\"(W) x 1.75\"(H) (305mm x 228.6mm x 44.45mm)\", word for word the GL-12xB-240D's; the reading of it there stands (19 in is the rack face with the ears, the 228.6 a slip for 482.6), and the CAD body is modelled. Ears are not drawn."
  },
  "cooling": {
   "confidence": "drawing",
   "note": "drawing - ten 40 x 20 mm fans, five behind each side-wall grille, so the air moves side to side. Which side takes air in is stated nowhere held."
  },
  "front-layout": {
   "confidence": "drawing",
   "note": "drawing - the fixed left panel (GL24X-1U-005B, x 0 to 132.4), the right panel (GL24X-1U-007B, x 414.5 to 440) and the card plates (the F-type plate GL24X-1U-F-PLATE and the blank GL24X-DANGPAN, x 132.7, 281.5 x 19.6) are the GL-12xB's boxes, the plates at the same y (1.8 and 22.5 on the model's face scale). The left panel's openings, lamps and jack positions are the GL-12xB-240D's, and the product render of this model shows the same panel."
  },
  "lifecycle": {
   "confidence": "datasheet",
   "note": "the GL-12xC-P600D data sheet is dated July 2026 and the vendor lists it as a current product; no end-of-life notice was found."
  },
  "line-cards": {
   "confidence": "datasheet",
   "note": "datasheet - \"(12) F Connector ReadyLink ports\" and \"Ports 11 and 12 of each line card are PoE++ ports\", with \"(10) PoE/PoE+ ... (2) PoE/PoE+/PoE++\", so the twelve F jacks are one card in a slot and not part of the chassis. The model agrees: the card (GL24XC_ASM, a GL24X-1U-F-PLATE plate 281.5 x 19.6) and the blank (GL24X-DANGPAN) are their own assemblies, one card in the upper slot and the blank in the lower, as the product render shows. The sheet's panel figure labels \"(12) F Connector ReadyLink ports\" over \"(2) Line card slots\"."
  },
  "poe-polarity": {
   "confidence": "datasheet",
   "note": "datasheet - the PoE row reads \"(F center pole: DC-, F shield: DC+)\": on an F jack the centre contact is DC- and the shell DC+."
  },
  "port-leds": {
   "confidence": "drawing",
   "note": "drawing - the status lamps, the SFP light pipes and the GbE corner lamps are the GL-12xB-240D's parts and positions; the port lamps are on the card."
  },
  "power": {
   "confidence": "datasheet",
   "note": "datasheet - \"Max power consumption 80W (Excluding PoE output)\" is power-self-max-w; \"Total available PoE 520W (Using dual power) 220W (Using single power)\" is the PoE budget; \"Power supply AC/DC, internal, (2) 300W\", printed unchanged from the 240D's sheet and taken as printed; \"Power input 100-240V AC, 50/60 Hz 48-56VDC\". The sheet gives no figure for the box at full PoE load, so power-max-w is not stated; the figures are not added. The supplies are inside and not field-replaceable, so they are not bays."
  },
  "rear-layout": {
   "confidence": "drawing",
   "note": "drawing - the GL-12xC model's rear is the GL-12xB's: two C14 inlets (POWER_1, 50.0 x 22.5, at 10.3 and 379.8), a rocker above each (KAIGUAN_1, 21 x 15 at 24.3 and 395.1) and two six-pole headers, to 0.1 mm. The data sheet's panel figure names \"Primary power\", \"Secondary power\" and \"DC power stacking ports\" as the 240D's does, and shows no other power arrangement; the legends and the ground stud are read as that device reads them."
  },
  "serial-label": {
   "confidence": "photo-measured",
   "note": "photo-measured - the white QR and serial sticker on the right panel, as on the 240D; drawn as a plain label plate with placeholder blocks, neither code nor serial transcribed."
  },
  "side-layout": {
   "confidence": "drawing",
   "note": "drawing - ten 40 x 20 mm fans (40X20_1) at the GL-12xB's five positions on each wall, the same x (3.0 and 417.0) and z; the grilles and screws are drawn as the 240D draws them."
  },
  "silkscreen": {
   "confidence": "drawing",
   "note": "drawing - the chassis legends are the GL-12xB-240D's reading, and the product render of this model prints the same words in the same places. Six sit off their part's centre (CONSOLE 1.66, USB 1.35, SFP+2 and SFP+1 0.78, GE2 and GE1 1.02 mm) as the CAD and the render place them, so L61 says so; they stay where the vendor puts them. The ReadyLinks wordmark is drawn as plain text and the wireless mark is not drawn (no vendor logos). The RL1 to RL12 legends are the card's."
  },
  "sources": {
   "confidence": "drawing",
   "note": "the vendor's 3D model of the GL-12xC (a CAD export, per-part meshes at millimetre scale), read with spec/tools/intake/glb_parts.py; the GL-12xC-P600D data sheet (five pages, July 2026, whose page 5 panel figure shows the front, rear and a three-quarter view); and the vendor product render of this model. The vendor publishes one 3D model per card build and none per power variant, so the chassis is the GL-12xC model's, which is the chassis readylinks/gl-12xb-240d models (#673); what is not restated here is that device's reading. The data sheet's panel figure and the product render show the P600D's front and rear to be the 240D's: the card in the upper slot, a plain plate in the lower, two C14 inlets and the DC power stacking ports behind."
  },
  "stack-orientation": {
   "confidence": "drawing",
   "note": "drawing - GE2 turned 180, the SFP+ pair belly to belly and the console latch at the bottom, as the GL-12xB-240D reads them from the same chassis."
  },
  "sync-jacks": {
   "confidence": "drawing",
   "note": "drawing - the sync block (SYNC_1) is 14.4 x 32.4 x 34.3 at x 72.4 in the GL-12xC model, as in the GL-12xB's, so they stay common/bnc-jack@1 as the 240D places them. The data sheet's panel figure calls them \"(2) BNC sync ports\" and nothing else names them; the signal is the same gap (sync-signal)."
  },
  "top-layout": {
   "confidence": "drawing",
   "note": "drawing - the lid (GL24X-1U-001B) is the same 427.5 x 293.8 sheet as the GL-12xB's. No photograph of the top is held; the data sheet's three-quarter view is of a twisted-pair sibling and its lid is plain."
  }
 },
