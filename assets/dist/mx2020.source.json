 "provenance": {
  "chassis": {
   "confidence": "datasheet",
   "note": "datasheet-table - 78.75 in (2000 mm) tall, 45U, same 440 mm body width and 919.5 mm depth as the MX2010. Ears NOT MODELLED by convention"
  },
  "color": {
   "note": "photo - grey chassis, dark craft band, silver-grey modules"
  },
  "front": {
   "note": "photo - the studio front photograph proportioned per-axis (~1.22 mm/px x, ~1.33 y): craft at y 12, EMI cover to 260, upper LC cage at y 300, the fabric cage at y 764.9 (ten 43.18 x 412.1 slots, the guides' SFB and CB-RE size, over the line-card slots, #902; it was y 770), lower LC cage at y 1225, intake grille at the base; positions approximate to ~5 mm on this face. All MX2000 components are shared with the MX2010"
  },
  "lc-slots": {
   "confidence": "datasheet",
   "note": "each LC slot is the line-card adapter's face, 43.18 x 449.8 (1.7 x 17.71 in, the guide's ADC row), on its own width as pitch: ten slots, 431.8 mm, centred on the chassis at x 4.1 (#261). Four readings put the pitch there: the MX2010 front gives 41.36 px between slots against a 379.5 px MPC plate, 43.3 mm on the card's 396.0; the MX2008 front, isotropic at 1.264 px/mm once its flanges are taken as the 19 in, gives 54.7 px, 43.3 mm; the MX2020 front gives 31.9 px at 0.744 px/mm, 43.4 mm. Until #261 the slots were an estimated 41.0 x 425.0 on a 41.0 pitch, which no adapter fits. The native MX2K cards and the blank keep their estimated 41 x 425 and are centred in the wider slot. Down: the photograph's LC cages are blanks at about 0.74 px/mm, too coarse to place an adapter by, so each cage keeps its modelled centre (512.5 and 1437.5) and grows to 449.8 about it: y 287.6 and 1212.6. The bands and the label strip beside them close up to clear."
  },
  "other-faces": {
   "note": "near-blank by evidence - rail bands estimated; axis conventions per viewer3d.js as the siblings"
  },
  "power": {
   "confidence": "datasheet",
   "note": "datasheet-table - the guide power overview: two -48 V pools as the MX2010 (8+1 per wall). No chassis draw is carried, because the guide contradicts itself - see the chassis-power-figure gap"
  },
  "rear": {
   "note": "photo - fan tray 3/2 grille, PDM3 zone, the upper nine-PSM wall, the centre grille, the lower nine-PSM wall, the PDM0 / air filter panel and the bottom grille. The photographed unit is -48 V DC. The PSM bay is drawn at the family 430 mm; this photograph reads nearer 375 and the difference is recorded here rather than silently split"
  },
  "slot-numbering": {
   "note": "guide + photo - the lower cage is LC 0-9 and the upper LC 10-19 (the label strips under each cage print them); PSM numbering across the two rear walls is not legible - see gaps"
  },
  "sources": {
   "note": "MX2020 Hardware Guide (960 pages), the MX2000 datasheet, and the studio front and rear photographs in the image library"
  }
 },
