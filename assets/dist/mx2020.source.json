 "datasheet": {
  "sha256": "ebc1a81a0210f826571936a4bfa6d41a98de5bc446aabc8d081a51c169a8e494",
  "title": "Juniper MX2000 Series datasheet"
 },
 "description": "Juniper MX2020 - the 45RU, two-metre flagship of the MX2000 family: the MX2010 doubled. Craft interface and EMI cover at the top, an upper cage of ten MPC slots (LC 10-19), the fabric cage (CB-RE 0, SFB 0-7, CB-RE 1) in the middle, a lower cage of ten more (LC 0-9), and the intake grille at the base. The rear carries two nine-module PSM walls between four power distribution modules, with fan trays behind the grilles.",
 "format": 1,
 "gaps": [
  {
   "reason": "needs-photo",
   "scope": [
    "psus"
   ],
   "wanted": "the printed PSM slot numbering across the two walls, and a dimensioned PSM - the bay is drawn at the family 430 mm where this photograph reads nearer 375.",
   "what": "psm-numbering-and-bay-height"
  },
  {
   "reason": "needs-photo",
   "scope": [
    "fpcs"
   ],
   "wanted": "a photograph of a populated LC slot on this chassis - the photographed front carries blanks in every LC slot. Since roc-ops/Portrayal#261 the MX240-form MPCs seat through the adapter card (juniper/mx2000-lc-adapter@1), as on the MX2010.",
   "what": "mpc-catalogue"
  },
  {
   "reason": "needs-photo",
   "scope": [
    "res",
    "sfbs"
   ],
   "wanted": "a photograph that resolves the fabric cage's height - its ten slots take the guides' 1.7 x 16.225 in (#902), and this photograph, proportioned per axis at about 1.33 mm/px down, cannot check the 412.1 mm against the cage it is drawn in.",
   "what": "fabric-cage-height"
  },
  {
   "reason": "needs-photo",
   "wanted": "the four fan trays and four PDMs as FRU bays - drawn as the grilles and zones they sit behind.",
   "what": "fan-trays-and-pdms"
  },
  {
   "note": "The guide states figures that do not hold together, so none is carried. Table 65 gives the base system (no MPCs, ADCs or MICs; four fan trays, eight PSMs) 9,439 W at 55 C and 2,142 W typical - the same two numbers the MX2010 guide (Table 60) gives its own, smaller base system, and 2,142 W is the MX2010 typical INPUT power per PSM (MX2010 guide Table 71). The DC thermal example (Table 91) assumes 34.5 kW of output for a loaded chassis as the zone 0 figure, more than half of the 45,000 W Table 89 gives the whole system including redundant capacity; the MX2010 guide (Table 84) uses the same 34.5 kW for its own chassis. Table 100, the typical thermal example, is garbled: it divides 36,274 by 0.91 and multiplies by 3.41 to reach 11,690 BTU/hr, which that arithmetic does not produce, and labels 36,274 as kW of output.",
   "reason": "sources-disagree",
   "scope": [
    "fact:peak-power-w",
    "fact:typical-power-w"
   ],
   "wanted": "an MX2020 power-planning page or datasheet that states a chassis draw, with its configuration, ambient and side.",
   "what": "chassis-power-figure"
  }
 ],
