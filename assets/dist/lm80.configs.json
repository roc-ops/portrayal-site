 "provenance": {
  "antenna": {
   "confidence": "drawing",
   "note": "The illustration and the photographs show two SMA connectors printed AUX and MAIN on a rounded plate at the left end. The option card brief, page 2, shows the same plate as the face of each 88-CAT4 cellular card, 50.3 mm wide and 22.9 mm high, so the plate is the face of the option slot with a cellular card in it. It is drawn 22.5 mm high, as the illustration reads. The face of a unit with another card, or none, is not shown in any held document."
  },
  "console": {
   "confidence": "datasheet",
   "note": "LM80 product brief: \"one RS-232 console port\", \"One USB-A port, one USB-C port\". The jack printed CON is the console jack, with the USB-A port and the USB-C port under it. The brief does not say what either USB port is for."
  },
  "layout-source": {
   "confidence": "drawing",
   "note": "Every position on the front is read off the maker's front illustration (2550 x 591 px). Its plate is 2377 px for 254 mm, which gives 9.36 px/mm across, and 407 px for 43 mm, which gives 9.46 px/mm down. The two agree within 1.1 per cent, so the figure is orthographic. Positions are read to about 0.5 mm. The base ports stand at the same distances from the left edge as on the LM83X, which is what the two illustrations show. The straight photograph agrees on the order and the count of every part."
  },
  "leds": {
   "confidence": "estimated",
   "note": "The illustration prints four small lamps with a power mark, a link mark, a warning mark and a pulse mark. No document says what any lamp shows. The round button is not named by any document and is not drawn as a part."
  },
  "mount": {
   "confidence": "estimated",
   "note": "The brief says the unit is \"well-suited for deployments that have physical space limitations, or in non-racked environments\" and lists no ear or rack kit. The photographs show a plain front with no ear. The unit is stated as a desktop device because no document shows a rack mount."
  },
  "network": {
   "confidence": "datasheet",
   "note": "LM80 product brief: \"Two 10/100/1000 BaseT Ethernet interfaces (with failover support)\", and \"One 1-Gbps SFP port\", besides the console port. The illustration prints E1 and E2 on two stacked jacks and E3 on the SFP cage."
  },
  "power": {
   "confidence": "datasheet",
   "note": "LM80 product brief: \"Internal universal power (100-240 VAC, 50/60 Hz); 30W\". The brief does not say whether 30 W is the draw or the rating, so it is filed as the maximum. No held document shows the inlet."
  },
  "serial": {
   "confidence": "drawing",
   "note": "LM80 product brief: \"Supports up to 8 devices via serial (RS-232)\". The illustration shows eight RJ45 jacks in two rows of four numbered 1 to 4 over 5 to 8 under blue bars. The jack centres are 16.1 mm apart across and 10.6 mm apart down. The ganged jack part is 11.0 mm high, so the rows are placed 11.0 mm apart, centred on the stack, 0.4 mm wider than the figure. The upper row is turned 180 degrees because its latch notch and lamp tabs are at the top."
  },
