  "chassis": {
   "confidence": "datasheet",
   "note": "datasheet (Dimension WxDxH 172 x 115 x 40mm; DC +12V/1.0A). Mount `desktop`: the reference front and rear views show the box standing on four corner feet with its LEDs on the top face."
  },
  "dc-in-rating": {
   "confidence": "datasheet",
   "note": "datasheet (DC +12V/1.0A): the `input-voltage` and `current-max-a` of the dc-in jack. The datasheet states no barrel size; the jack is the library's one nominal `dc-barrel`."
  },
  "environment": {
   "confidence": "datasheet",
   "note": "datasheet - operating 0 to 45 C is printed in both the leaflet (page 2, Hardware Specification) and the guide (page 9); storage -20 to 70 C only in the leaflet. Humidity is not carried because the two differ (see the gap)."
  },
  "jack-finish": {
   "confidence": "photo-measured",
   "note": "photo-measured (IMG_2099, the rear face, and the guide's Fig. 2 on page 5, agree): the LAN jack's housing is yellow plastic and the 10G jack's is black. The yellow is the median of the yellow pixels of the LAN jack in IMG_2099, #ccb339, taken under a warm light (the white body reads #d2ccbf in the same frame), so it is the photograph's yellow and not a maker's colour code. The black is the library's own #2b2f33 for a black jack."
  },
  "physical": {
   "confidence": "datasheet",
   "note": "datasheet - the Quick Installation Guide, page 9, prints \"<500g\" and no figure the leaflet repeats. A bound is not a weight, so it is carried as a note and `weight-kg` is not stated."
  },
  "pon-caption": {
   "note": "the white plastic underside carries NO printing beside the fibre bay (IMG_2095, IMG_2096). PON SC/APC was therefore never silkscreen: it is the modeller naming a part, and silkscreen[] means ink on the moulding. It is now a region, which is what this project has for author annotation, so the drawing no longer claims the vendor printed something it did not"
  },
  "rear-layout": {
   "confidence": "photo-measured",
   "note": "photo-measured (stock rear photo, labels ON/OFF POWER 10G LAN RESET TEL2 TEL1)"
  },
  "rear-pon-caption": {
   "confidence": "estimated",
   "note": "estimated - IMG_2099 shows \"PON\" printed on the rear face beside the fibre-bay notch, below ON/OFF. Place read off the photograph at the face's own scale (172 mm is 810 px), about 2 mm good; the size is the other rear captions'. The underside carries no such print (IMG_2095)."
  },
  "side-screws": {
   "confidence": "estimated",
   "note": "estimated - IMG_2097 and IMG_2098 (the same face twice) show a cross-head screw near each end of the right face, one at the rear end near the top edge and one at the front end near the bottom edge, a diagonal pair. Places read off IMG_2097 at the face's own scale (115 mm is 880 px): centres 107.8 mm from the front and 7.4 mm down, and 8.5 mm from the front and 31.0 mm down, each good to about 2 mm. The head is about 5 mm across by the same scale. The left face is not photographed, so none is drawn there (see the gap)."
  },
  "top-layout": {
   "confidence": "photo-measured",
   "note": "photo-measured (owner capture with ruler; 8 labeled LEDs + 1 unlabeled position)"
  }
 },
