 "format": 1,
 "gaps": [
  {
   "note": "The leaflet (page 2) prints \"172 x 115 x 40mm (W x D x H)\", which the chassis carries. The Quick Installation Guide (page 9) prints \"L x W x H: 112mm x 162mm x 42mm\". The two share neither a length nor a height. The photographs show a top face about 1.5 times as long as it is wide, which fits 172 / 115 = 1.50 better than 162 / 112 = 1.45, but the top face stands above the ruler in them and the scale is not the ruler's, so they do not settle it.",
   "reason": "sources-disagree",
   "wanted": "The unit measured with a rule or calliper, or the maker's mechanical drawing.",
   "what": "dimensions-disagree"
  },
  {
   "note": "Three figures for one 12 V DC input. The leaflet (page 2, Power Supply) prints \"DC +12V / 1.0A\", which the jack carries as `current-max-a`. The Quick Installation Guide (page 9, \"Whole-device power supply\") prints \"12V DC / 2A\". The unit's own rating label (IMG_2095, IMG_2096, dated 2022.12) prints \"12V\" and \"1.5A\". The voltage agrees in all three.",
   "reason": "sources-disagree",
   "scope": [
    "dc-in"
   ],
   "wanted": "Which of 1.0 A, 1.5 A and 2 A is the rating of the adapter shipped with a current unit.",
   "what": "dc-in-current-disagrees"
  },
  {
   "note": "Operating humidity is \"10% - 95% (non-condensing)\" in the leaflet (page 2) and \"10%~90% (non-condensing)\" in the Quick Installation Guide (page 9). Neither is carried.",
   "reason": "sources-disagree",
   "wanted": "The maker's answer, or the later of the two documents confirmed as current.",
   "what": "humidity-disagrees"
  },
  {
   "note": "The only side face photographed is the right one (IMG_2097, IMG_2098). The left face is drawn as ribs alone and no screw is claimed on it.",
   "reason": "needs-photo",
   "scope": [
    "left"
   ],
   "wanted": "A photograph of the left face, square on, with a rule beside it.",
   "what": "left-face-unphotographed"
  },
  {
   "note": "IMG_2097 shows the right face with a solid band at each end (about 16 mm at the front end and 15 mm at the rear end, where the screws are), the slots only in a middle band, and ribs that run out to the lower edge. The face is drawn as ribs from end to end, which the photograph does not show. The slot and rib sizes are not read here.",
   "reason": "needs-drawing",
   "scope": [
    "right"
   ],
   "wanted": "A square-on photograph of the right face with a rule beside it, to draw the bands, slots and ribs.",
   "what": "right-face-vents"
  },
  {
   "note": "IMG_2099 shows both telephone jacks in a grey housing. common/rj11-jack@1 has no finish field, so the drawing keeps the part's own colour; changing it is an edit to a part many devices place.",
   "reason": "needs-drawing",
   "scope": [
    "fxs"
   ],
   "wanted": "A finish field on the telephone jack, once the colour is checked against a second device.",
   "what": "fxs-jack-colour"
  }
 ],
