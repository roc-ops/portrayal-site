# Response headers for the teaser. Cloudflare's Workers static assets read this
# file from the root of the folder wrangler.jsonc deploys; it is not served itself.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The page revalidates, so an edit shows up on the next load.
/
  Cache-Control: public, max-age=0, must-revalidate

# Images are replaced rarely; a day is long enough to spare the edge and
# short enough that a new hero does not linger.
/*.png
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
# The 3D loop: a day, as the images.
/*.webm
  Cache-Control: public, max-age=86400
/*.mp4
  Cache-Control: public, max-age=86400

# The Portrayal JSON schemas (roc-ops/portrayal-site#58), published at the flip
# by tools/publish-schemas.sh. Each is served at the URL its $id names, as JSON,
# and readable cross-origin, since validators and editors fetch them from
# anywhere. v1/ is permanent; a format 2 goes under /schemas/v2/ beside it.
# No Content-Type here: Cloudflare types a .json file as application/json from
# its extension, and a rule here also applies to the 404 page served for a
# missing schema - it labeled that HTML page application/json (seen live). The
# same goes for Cache-Control, so it is short: a 404 fetched just before the
# schemas are published must not linger.
/schemas/v1/*.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
