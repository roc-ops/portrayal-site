# Response headers for the full site. Cloudflare's Workers static assets read
# this file from the root of the folder wrangler.jsonc deploys (public/, built
# by tools/build-public.py); it is not served itself.
#
# CACHING: nothing here sets Cache-Control for pages, scripts, styles or the
# compiled library, so they keep Cloudflare's default - revalidate on every
# load against the ETag. None of those URLs is content-hashed: a drawing and
# the configs.json that names it must never be served from two different
# deploys. Only media/, whose files are replaced rarely, caches for a day.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The teaser's media, kept at permanent URLs: the Portrayal README links the
# 3D video (roc-ops/portrayal-site#61).
/media/*
  Cache-Control: public, max-age=86400

# The Portrayal JSON schemas (roc-ops/portrayal-site#58), published by
# tools/publish-schemas.sh. Each is served at the URL its $id names, and
# readable cross-origin, since validators and editors fetch them from
# anywhere. Each label is permanent: v1/ holds format 1 (and rack file
# version 2), v2/ the rack file at version 3 (Portrayal #921), v3/ the rack
# file from version 4 (half-unit positions, Portrayal #935). One block per
# label, so a label is served only once it is meant to be.
# NO Content-Type here: Cloudflare types a .json file as application/json from
# its extension, and a rule here also applies to the 404 page served for a
# missing schema - it labeled that HTML page application/json (seen live).
/schemas/v1/*.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/schemas/v2/*.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/schemas/v3/*.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# A page whose rows a script draws names its data file, for agents: its
# Markdown copy has no rows (tools/page_markdown.py). The same link is in the
# page's <head>; check-contract.py holds the two together.
/components/catalog
  Link: </assets/dist/components.json>; rel="alternate"; type="application/json"

/lint
  Link: </assets/dist/lint-rules.json>; rel="alternate"; type="application/json"
