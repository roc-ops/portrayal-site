#!/bin/sh
# The checks, before the push rather than after it.
#
# Not a replacement for .github/workflows/checks.yml, and not made redundant by
# it either. This runs against YOUR TREE, so it is fast and it catches what you
# are about to push; the workflow runs against a clean checkout, which is the
# only place a page that depends on an untracked file looks broken. The front
# page's hero was missing from every fresh clone and present for everyone who
# had run the exporter - this hook could not have seen that, and did not.
#
# Install it once, for this clone and every worktree of it:
#
#     git config core.hooksPath hooks
#
# Committed rather than copied into .git/hooks, because a hook nobody can see in
# a diff is a hook that drifts. `git push --no-verify` skips it, which is the
# right escape hatch for a work-in-progress branch - and the wrong one for main.
set -e

CONTRACT="check-contract.py"
BROWSER="check-browser.py"

# WHAT A PUSH HAS TO EARN. The contract check reads files and takes under a
# second, so it runs always. The browser pass opens every page, walks the
# showcase and the rack builder in 2D and 3D, and presses Run on the marks
# harness: six to nine minutes, which is worth paying when the push can break a
# page and is worth skipping when it plainly cannot. A pre-push hook that costs
# that on a README fix is a hook that gets --no-verify'd into retirement, and
# then neither check runs.
touches_the_site() {
  # Anything the pages load, are, or are served by. assets/ is in the list
  # because a drawing that goes away is a page that fetches a 404.
  grep -qE '^(vendor/|site/|assets/|brand/|tests/|[^/]+\.html$|check-browser\.py$|serve\.py$)'
}

# GIT OPENS THE CONNECTION BEFORE IT RUNS THIS HOOK, and over SSH that
# connection sits idle until the hook is done. GitHub closes an idle one after a
# few minutes, so a browser pass that passes is followed by
# "Connection to github.com closed by remote host" and a push that failed
# (portrayal-site#79). Measured with a hook that only slept for seven minutes:
# plain SSH was dropped, SSH with ServerAliveInterval=30 pushed, HTTPS pushed -
# it asks again after the hook rather than holding a session open. So the fix
# is a keepalive, set once per clone, and this says so BEFORE the long pass
# rather than after it. A warning and not a refusal: a machine that finishes
# under GitHub's limit pushes fine without one.
remote_url="${2:-}"
keepalive_ok() {
  case "$remote_url" in
    http://*|https://*|file://*|/*|.*) return 0 ;;      # not SSH: nothing to keep alive
  esac
  printf %s "${GIT_SSH_COMMAND:-} $(git config core.sshCommand 2>/dev/null)" \
    | grep -qE 'ServerAliveInterval[= ]*[1-9]' && return 0
  host=$(printf %s "$remote_url" | sed -E 's#^ssh://##; s#^[^@/]*@##; s#[:/].*$##')
  [ -n "$host" ] || return 0
  ssh -G "$host" 2>/dev/null | grep -qE '^serveraliveinterval [1-9]'
}

z=0000000000000000000000000000000000000000
changed=""
full=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$z" ] && continue            # deleting a ref pushes nothing
  if [ "$remote_sha" = "$z" ]; then
    # A BRANCH THE REMOTE HAS NOT SEEN. There is no "since" to diff from, so
    # ask what it adds over the default branch; if that is unknown too - a
    # fresh clone with no origin/main - check everything rather than guess.
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || base=""
    if [ -n "$base" ]; then
      changed="$changed
$(git diff --name-only "$base" "$local_sha")"
    else
      full=1
    fi
  else
    changed="$changed
$(git diff --name-only "$remote_sha" "$local_sha")"
  fi
done

# Nothing on stdin and nothing resolved: `git push` with no new commits.
[ -z "$(printf %s "$changed" | tr -d '[:space:]')" ] && [ "$full" = 0 ] && exit 0

echo "pre-push: $CONTRACT"
python3 "$CONTRACT"

# The rack builder's pure modules: no browser, a second or two, so always.
if command -v node >/dev/null 2>&1 && ls tests/rack/*.test.mjs >/dev/null 2>&1; then
  echo "pre-push: node --test tests/rack"
  node --test tests/rack/*.test.mjs
fi

if [ "$full" = 1 ] || printf %s "$changed" | touches_the_site; then
  if python3 -c "import playwright" 2>/dev/null; then
    if ! keepalive_ok; then
      echo "pre-push: WARNING - this push is over SSH with no keepalive, and GitHub" >&2
      echo "          drops an idle connection before the browser pass ends, so the" >&2
      echo "          push will likely fail after the checks pass. Once per clone:" >&2
      echo "            git config core.sshCommand \"ssh -o ServerAliveInterval=30\"" >&2
    fi
    echo "pre-push: $BROWSER (six to nine minutes; --no-verify skips it)"
    python3 "$BROWSER"
  else
    # NOT FATAL BY DEFAULT, and loud. A hook that refuses to push because an
    # optional dependency is missing teaches one lesson - how to bypass it.
    echo "pre-push: skipping $BROWSER - no playwright here" >&2
    echo "          pip install playwright && playwright install chromium" >&2
    if [ -n "${PORTRAYAL_HOOK_STRICT:-}" ]; then
      echo "pre-push: PORTRAYAL_HOOK_STRICT is set, so that is a failure" >&2
      exit 1
    fi
  fi
fi
